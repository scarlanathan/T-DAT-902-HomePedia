# Homepedia Airflow (HOM-22) — copy to .env and adjust.

# --- Host user (Linux/WSL: run `id -u` and set it so mounted logs are writable).
# On Docker Desktop (Windows/macOS) the default is fine.
AIRFLOW_UID=50000

# --- Airflow web login (created by airflow-init) ---
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# --- Connection to the data_platform warehouse (../docker-compose.yml) ---
# host.docker.internal works on Docker Desktop and on Linux via the extra_hosts
# host-gateway mapping in docker-compose.yml. Override if your Postgres is elsewhere.
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_USER=homepedia
POSTGRES_PASSWORD=homepedia
POSTGRES_DEV_DB=homepedia
POSTGRES_SCHEMA=public

# --- Optional ingestion overrides (leave blank to use the DAG defaults,
#     which mirror scripts/load_all_default.sh) ---
# Cap DVF rows to keep scheduled runs fast during dev (national file is ~5M rows).
DVF_MAX_ROWS=100000
# DVF_CSV_URL=
# COG_COMMUNE_URL=
# COG_DEPARTEMENT_URL=
# COG_REGION_URL=
# BPE_URL=
# BPE_MILLESIME=2024
# BPE_TYPEQU_FILTER=C101,C102,C201,C301,D101,D201,D501,A504,A505
# FILOSOFI_COMMUNE_URL=
# FILOSOFI_IRIS_URL=

# --- Optional failure notifications ---
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
