# Hadoop / Spark configuration shared by every container in the cluster.
# The bde2020 images translate each VAR into the matching *-site.xml property,
# so editing here is equivalent to editing core-site.xml / hdfs-site.xml.

# --- core-site.xml ---
CORE_CONF_fs_defaultFS=hdfs://namenode:9000
CORE_CONF_hadoop_http_staticuser_user=root
CORE_CONF_io_compression_codecs=org.apache.hadoop.io.compress.SnappyCodec

# --- hdfs-site.xml ---
# Single datanode in dev, so replication factor 1 (no point asking for 3 copies).
HDFS_CONF_dfs_replication=1
HDFS_CONF_dfs_webhdfs_enabled=true
HDFS_CONF_dfs_permissions_enabled=false
HDFS_CONF_dfs_namenode_datanode_registration_ip___hostname___check=false

# --- yarn-site.xml (kept minimal: we run Spark standalone, not on YARN) ---
YARN_CONF_yarn_resourcemanager_hostname=namenode
